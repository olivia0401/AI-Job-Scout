# Personal data: resume, scan results, caches, API keys - never baked into the
# image (provided at runtime via the mounted volume)
data/
.env

# Version control and dev files
.git/
.github/
.gitignore
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/

# Tests / evaluation (not needed at runtime)
tests/
eval/

# Exported spreadsheets, local launchers, docs
*.xlsx
*.csv
Start-Job-Scout.bat
README.md
